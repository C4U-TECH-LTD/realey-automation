{
  "name": "realey-playwright-allure-js",
  "version": "1.0.0",
  "private": true,
  "description": "JavaScript Playwright automation framework for Realey UAT with Cucumber and Allure reports.",

  "scripts": {
    "test": "playwright test --project=chrome",

    "test:headed": "playwright test --project=chrome --headed",

    "test:debug": "playwright test --project=chrome --debug",

    "test:smoke": "playwright test tests/smoke --project=chrome",

    "test:auth": "playwright test tests/auth --project=chrome",

    "test:chrome": "playwright test --project=chrome",

    "test:cucumber": "cucumber-js",

    "test:cucumber:smoke": "cucumber-js --tags \"@smoke\"",

    "test:cucumber:login": "cucumber-js --tags \"@login\"",

    "test:cucumber:listing": "cucumber-js --tags \"@listing\"",

    "test:cucumber:regression": "cucumber-js --tags \"@regression\"",

    "test:fixed-price": "cucumber-js --tags \"@flow-1\"",

    "test:flow-1": "cucumber-js --tags \"@flow-1\"",

    "test:flow-2": "cucumber-js --tags \"@flow-2\"",

    "test:flow-3": "cucumber-js --tags \"@flow-3\"",

    "test:flow-4": "cucumber-js --tags \"@flow-4\"",

    "test:flow-5": "cucumber-js --tags \"@flow-5\"",

    "test:flow-6": "cucumber-js --tags \"@flow-6\"",

    "test:flow-7": "cucumber-js --tags \"@flow-7\"",

    "test:flow-8": "cucumber-js --tags \"@flow-8\"",

    "test:flow-9": "cucumber-js --tags \"@flow-9\"",

    "test:all-flows": "cucumber-js --tags \"@all-flows\"",

    "report:generate": "allure generate allure-results --clean -o allure-report",

    "report:open": "allure open allure-report",

    "report:serve": "allure serve allure-results",

    "allure:cucumber": "npm run test:fixed-price && npm run report:generate",

    "clean": "node scripts/clean.js"
  },

  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.55.0",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.3.3",
    "allure-playwright": "^3.3.3",
    "dotenv": "^17.2.1"
  },

  "dependencies": {
    "mailosaur": "^11.1.1",
    "mailslurp-client": "^17.4.0"
  }
}